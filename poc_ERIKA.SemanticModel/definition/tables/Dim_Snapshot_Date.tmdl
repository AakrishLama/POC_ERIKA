/// Snapshot date role-playing dimension.
table Dim_Snapshot_Date
	lineageTag: 1c5b6a8d-42c7-4f91-9d03-6e7a8b2c5f10
	sourceLineageTag: [star].[Dim_Date]

	/// Generated: YYYYMMDD integer format
	column DateKey
		dataType: int64
		formatString: 0
		lineageTag: 2d6c7b9e-53d8-4fa2-ae14-7f8b9c3d6a21
		sourceLineageTag: DateKey
		summarizeBy: count
		sourceColumn: DateKey

	/// Generated: Calendar Date
	column FullDate
		dataType: dateTime
		formatString: General Date
		lineageTag: 3e7d8caf-64e9-4ab3-bf25-89cad4e7b320
		sourceLineageTag: FullDate
		summarizeBy: none
		sourceColumn: FullDate

	/// Generated: Year component
	column Year
		dataType: int64
		formatString: 0
		lineageTag: 4f8e9db7-75fa-4cc4-c636-9abde5f8c430
		sourceLineageTag: Year
		summarizeBy: sum
		sourceColumn: Year

	/// Generated: Month component
	column Month
		dataType: int64
		formatString: 0
		lineageTag: 5a9fadc8-86ab-4dd5-d847-a1bcef6c9d54
		sourceLineageTag: Month
		summarizeBy: sum
		sourceColumn: Month

	/// Generated: Day component
	column Day
		dataType: int64
		formatString: 0
		lineageTag: 6abed1a9-97ac-45e6-ae58-b1cdf07aae65
		sourceLineageTag: Day
		summarizeBy: sum
		sourceColumn: Day

	/// Generated: Business logic (weekend/holiday flag)
	column IsWorkingDay
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 7bcfe1a8-08ad-46f7-bf69-c1deab8abf76
		sourceLineageTag: IsWorkingDay
		summarizeBy: none
		sourceColumn: IsWorkingDay

	partition Dim_Snapshot_Date = entity
		mode: directLake
		source
			entityName: Dim_Date
			schemaName: star
			expressionSource: 'DirectLake - poc_wh'
